# ============================================================================
# .dockerignore - Files to exclude from Docker build context
# ============================================================================

# Version Control
.git
.gitignore
.gitattributes

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json

# Virtual Environments
venv/
env/
ENV/
.venv/

# Frontend
frontend/node_modules/
frontend/.vite/
frontend/dist/
frontend/build/
frontend/.cache/

# Logs
*.log
logs/
backend/logs/

# Environment Files (secrets should be in Secret Manager)
.env
.env.local
.env.*.local
backend/.env

# Test Files
tests/
**/tests/
**/__tests__/
*.test.js
*.spec.js
*.test.ts
*.spec.ts
coverage/

# Documentation (not needed in container)
DOCUMENTATION/
docs/
*.md
!README.md

# Deployment Files
DEPLOYMENT/
terraform/
.terraform/
*.tfstate
*.tfstate.backup

# CI/CD
.github/
.gitlab-ci.yml
.circleci/
azure-pipelines.yml
cloudbuild.yaml

# Generated Files
backend/diagrams/generated/
*.svg
*.png
results/

# Scripts (not needed in production)
scripts/
setup/
*.ps1
*.bat
*.sh

# Database
*.db
*.sqlite
*.sqlite3

# Temporary Files
tmp/
temp/
*.tmp
*.bak

# Archives
*.zip
*.tar
*.tar.gz
*.rar
inactivetests.zip

# OS Files
Thumbs.db
desktop.ini

# Project-specific
backend/testversion1/
backend/inactivetests/
frontend/demo.html
frontend/test-diagrams.js
