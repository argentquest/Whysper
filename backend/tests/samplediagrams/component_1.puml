@startuml
package "Web Application" {
  actor User
  component Controller [
    Controller
    Spring MVC
  ]
  component Service [
    Service
    Spring Service
  ]
  component Repository [
    Repository
    JPA
  ]
}

database MySQL [
  Database
  MySQL
]

User --> Controller : Uses
Controller --> Service : Invokes
Service --> Repository : Uses
Repository --> MySQL : Reads/Writes
@enduml