@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
Person(user, "User")
Container(webApp, "Web App", "Java", "Handles requests")
Container_Db(db, "Database", "MySQL")
Component(controller, "Controller", "Spring MVC", "Handles HTTP requests")
Component(service, "Service", "Spring Service", "Business logic")
Component(repo, "Repository", "JPA", "Data access")
Rel(user, controller, "Uses")
Rel(controller, service, "Invokes")
Rel(service, repo, "Uses")
Rel(repo, db, "Reads/Writes")
@enduml