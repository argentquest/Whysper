@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
System_Boundary(s1, "CRM") {
  Container(ui, "UI")
  Container(api, "API")
  Container(db, "Database")
}
Person(sales, "Sales Rep")
Rel(sales, ui, "Uses")
Rel(ui, api, "Calls")
Rel(api, db, "Reads/Writes")
@enduml