@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
Person(user, "User")
System_Boundary(system, "Analytics System") {
  Container(ui, "Dashboard", "Angular", "Displays metrics")
  Container(api, "API", "Python", "Processes data")
  Container(db, "Database", "BigQuery", "Stores analytics")
}
Rel(user, ui, "Views metrics")
Rel(ui, api, "Requests data")
Rel(api, db, "Queries")
@enduml