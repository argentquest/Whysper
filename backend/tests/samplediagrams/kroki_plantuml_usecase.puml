@startuml E-Commerce System
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_UseCase.puml

actor Customer
actor Admin
usecase "Browse Products" as UC1
usecase "Add to Cart" as UC2
usecase "Checkout" as UC3
usecase "Process Payment" as UC4
usecase "View Orders" as UC5
usecase "Manage Inventory" as UC6
usecase "Generate Reports" as UC7

Customer --> UC1
Customer --> UC2
Customer --> UC3
UC3 --> UC4
Customer --> UC5
Admin --> UC6
Admin --> UC7

@enduml
