@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
Person(user, "User")
System_Boundary(app, "Mobile App") {
  Container(ui, "UI", "Flutter", "User interface")
  Container(api, "API", "Go", "Handles logic")
  Container(db, "Database", "SQLite", "Stores data")
}
Rel(user, ui, "Interacts with")
Rel(ui, api, "Sends requests")
Rel(api, db, "Reads/Writes")
@enduml