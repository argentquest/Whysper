direction: down

# Header Section
header: {
  label: "HEADER - Well Fargo | Architecture Gen Studio\nAgent Selector Dropdown\nNav: Home >> Current Home | Architecture Gen Studio > New Page | Settings \\ Help\nUser Account | Notifications | Sticky"
  style: {
    fill: "#2C3E50"
    stroke: "#34495E"
    text: {
      color: "#ECF0F1"
      font-size: 12
    }
  }
}

# Main Content Area with Three Columns
main_area: {
  direction: right

  left_column: {
    label: "LEFT COLUMN\nPrompt Control Panel\n\nSubAgent List (from header)\nMonaco Prompt Editor\nSubmit Button\n\nCollapsible | Resizable\nIndependent Scrollbar\nActive States"
    style: {
      fill: "#ECF0F1"
      stroke: "#95A5A6"
      text: {
        font-size: 10
      }
    }
  }

  center_column: {
    label: "CENTER COLUMN\nDiagram Rendering & Visualization\n\nTabs: Mermaid | D2 | Structurizr | PlantUML\nDiagram Render Area\nZoom In/Out | SVG Download\nMinimize/Maximize Buttons\n\nCollapsible | Resizable\nIndependent Scrollbar"
    style: {
      fill: "#FFFFFF"
      stroke: "#34495E"
      text: {
        font-size: 10
      }
    }
  }

  right_column: {
    label: "RIGHT COLUMN\nCode Editor & Validation\n\nMonaco Code Editor (Editable)\nValidate Button | Render Button\nError Display (Collapsible)\n\nCollapsible | Resizable\nIndependent Scrollbar\nContextual Updates from Center"
    style: {
      fill: "#ECF0F1"
      stroke: "#95A5A6"
      text: {
        font-size: 10
      }
    }
  }
}

# Footer Section
footer: {
  label: "FOOTER - Status Bar\nColumn 1: Current Status | Column 2: SSE Backend Messages | Column 3: About | Help\nDisclaimer: Information was AI Generated"
  style: {
    fill: "#2C3E50"
    stroke: "#34495E"
    text: {
      color: "#ECF0F1"
      font-size: 10
    }
  }
}

# Layout flow
header -> main_area
main_area -> footer
