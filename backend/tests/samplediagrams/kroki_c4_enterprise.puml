@startuml Enterprise Architecture - C4 System Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Enterprise System Architecture - System Context

Person(customer, "Customer", "Uses the system")
Person(admin, "Administrator", "Manages the system")

System_Boundary(enterprise, "Enterprise") {
    System(webs, "Web Application", "Provides business functionality")
    System(api, "API Server", "REST API for integrations")
    System(mobile, "Mobile App", "Native mobile application")
}

System_Ext(sso, "SSO System", "Central authentication")
System_Ext(payment, "Payment Gateway", "Processes payments")
System_Ext(email, "Email Service", "Sends notifications")

Rel(customer, webs, "Uses")
Rel(customer, mobile, "Uses")
Rel(admin, webs, "Manages")
Rel(webs, api, "Calls")
Rel(mobile, api, "Calls")
Rel(webs, sso, "Authenticates with")
Rel(webs, payment, "Processes payments via")
Rel(webs, email, "Sends emails via")

@enduml
