@startuml Deployment Architecture - C4 Container + Deployment
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Online Banking System - Container Diagram

Person(customer, "Customer", "Wants to manage accounts")

System_Boundary(banking, "Banking System") {
    Container(web, "Web Application", "Spring Boot", "Provides online banking UI")
    Container(mobile, "Mobile App", "React Native", "Mobile banking interface")
    Container(api, "API Gateway", "Node.js", "REST API for all clients")

    Container_Boundary(backend, "Backend Services") {
        Container(auth, "Auth Service", "Java", "User authentication & authorization")
        Container(account, "Account Service", "Java", "Account management")
        Container(transaction, "Transaction Service", "Java", "Transaction processing")
    }

    Container(cache, "Cache", "Redis", "Session & data caching")
    Container(db, "Database", "PostgreSQL", "Primary data store")
}

System_Ext(payment, "Payment Network", "Processes card payments")

Rel(customer, web, "Uses [HTTPS]")
Rel(customer, mobile, "Uses [HTTPS]")
Rel(web, api, "Calls [REST/JSON]")
Rel(mobile, api, "Calls [REST/JSON]")
Rel(api, auth, "Delegates to")
Rel(api, account, "Delegates to")
Rel(api, transaction, "Delegates to")
Rel(auth, db, "Reads/Writes [SQL]")
Rel(account, db, "Reads/Writes [SQL]")
Rel(transaction, db, "Reads/Writes [SQL]")
Rel(auth, cache, "Caches sessions in")
Rel(transaction, payment, "Processes via [HTTPS]")

@enduml
