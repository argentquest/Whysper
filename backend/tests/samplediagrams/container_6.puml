@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
Person(user, "User")
System_Boundary(system, "Booking System") {
  Container(web, "Web App", "PHP", "Booking interface")
  Container(api, "API", "Python", "Processes bookings")
  Container(db, "Database", "MariaDB", "Stores bookings")
}
Rel(user, web, "Books")
Rel(web, api, "Sends booking")
Rel(api, db, "Stores booking")
@enduml