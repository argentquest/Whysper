@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
Person(admin, "Admin")
Container(api, "API Server", "Python", "REST API")
Container_Db(db, "Database", "MongoDB")
Component(auth, "Auth Module", "Flask", "Handles authentication")
Component(data, "Data Module", "Flask", "Manages data")
Rel(admin, auth, "Logs in")
Rel(auth, data, "Grants access")
Rel(data, db, "Reads/Writes")
@enduml