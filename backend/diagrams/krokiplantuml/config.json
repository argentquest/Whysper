{
  "provider_id": "krokiplantuml",
  "provider_name": "Kroki PlantUML Renderer",
  "description": "PlantUML diagrams via Kroki service at http://localhost:8000",

  "diagram_type": "plantuml",
  "supported_output_formats": ["svg", "png"],

  "overrides": {
    "llm_correction": {
      "max_retries": 5,
      "max_tokens": 6000
    },

    "validation": {
      "timeout_seconds": 30
    },

    "rendering": {
      "timeout_seconds": 30
    }
  },

  "custom": {
    "server_url": "http://localhost:8000",
    "diagram_endpoint": "plantuml",
    "timeout_seconds": 30,
    "max_retries": 3
  }
}