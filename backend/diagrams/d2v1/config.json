{
  "provider_id": "d2v1",
  "provider_name": "D2 CLI Renderer v1",
  "description": "D2 diagram renderer using d2 CLI tool",

  "diagram_type": "d2",
  "supported_output_formats": ["d2", "svg"],

  "overrides": {
    "llm_correction": {
      "max_retries": 8,
      "max_tokens": 6000
    },

    "batch": {
      "enabled": true,
      "max_items": 100
    }
  },

  "custom": {
    "executable_name": "d2",
    "executable_path": null,
    "auto_detect_executable": true,
    "layout_engine": "dagre",
    "theme": "default"
  }
}
